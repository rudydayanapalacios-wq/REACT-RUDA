                    leading-tight
                  "
              >
                Tu aventura

                <span
                  className="
                      block
                      text-[#D4AF37]
                    "
                >
                  comienza aquÃ­.
                </span>
              </h1>

              <p
                className="
                    mt-6
                    max-w-md
                    leading-relaxed
                    text-white/70
                  "
              >
                Entra a tu tripulaciÃ³n y continÃºa
                explorando nuestra colecciÃ³n inspirada
                en el Grand Line.
              </p>

            </div>

            {/* FRASE */}

            <div
              className="
                  relative
                  z-10
                  border-t
                  border-white/20
                  pt-6
                "
            >

              <p
                className="
                    font-serif
                    text-lg
                    italic
                    text-white/80
                  "
              >
                "El mar siempre guarda una nueva aventura."
              </p>

              <p
                className="
                    mt-2
