// ============================================================
// PÃGINA LOGIN
// ============================================================

import { useState } from "react";
import { useAuth } from "../context/AuthContext";
import { Link } from "react-router-dom";
import logo from "../assets/img/logo.png";
import RegistroModal from "../components/RegistroModal";
import RecuperarContrasena from "../components/RecuperarContraseña";

// ============================================================
// COMPONENTE LOGIN
// ============================================================

function Login() {
  const { iniciarSesion } = useAuth();
  // ==========================================================
  // ESTADOS
  // ==========================================================

  const [mostrarPassword, setMostrarPassword] = useState(false);
  const [mostrarRegistro, setMostrarRegistro] = useState(false);
  const [mostrarRecuperar, setMostrarRecuperar] = useState(false);

  const [formulario, setFormulario] = useState({
    email: "",
    password: "",
  });

  const [errores, setErrores] = useState({});
  const [cargando, setCargando] = useState(false);

  // NUEVO: estado para mostrar alerta de login exitoso
  const [mostrarAlerta, setMostrarAlerta] = useState(false);

  // ==========================================================
  // MANEJAR CAMBIOS DEL FORMULARIO
  // ==========================================================

  const manejarCambio = (e) => {
    const { name, value } = e.target;

    setFormulario((anterior) => ({
      ...anterior,
      [name]: value,
    }));

    // ========================================================
    // VALIDACIÃ“N EN TIEMPO REAL
    // ========================================================

    let mensaje = "";

    if (name === "email") {
      if (!value.trim()) {
        mensaje = "El correo electrÃ³nico es obligatorio.";
      } else if (
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
      ) {
        mensaje = "Ingresa un correo electrÃ³nico vÃ¡lido.";
      }
    }

    if (name === "password") {
      if (!value) {
        mensaje = "La contraseÃ±a es obligatoria.";
      } else if (value.length < 9) {
        mensaje = "La contraseÃ±a debe tener mÃ­nimo 8 caracteres.";
      }
    }

    setErrores((anterior) => ({
      ...anterior,
      [name]: mensaje,
    }));
  };

  // ==========================================================
  // ABRIR REGISTRO
  // ==========================================================

  const abrirRegistro = () => {
    setMostrarRegistro(true);
  };

  // ==========================================================
  // CERRAR REGISTRO
  // ==========================================================

  const cerrarRegistro = () => {
    setMostrarRegistro(false);
  };

  // ==========================================================
  // ABRIR RECUPERAR CONTRASEÃ‘A
  // ==========================================================

  const abrirRecuperar = () => {
    setMostrarRecuperar(true);
  };

  // ==========================================================
  // CERRAR RECUPERAR CONTRASEÃ‘A
  // ==========================================================

  const cerrarRecuperar = () => {
    setMostrarRecuperar(false);
  };

  // ==========================================================
  // REGISTRO COMPLETADO
  // ==========================================================

  const manejarRegistro = (usuario) => {
    console.log("Usuario registrado:", usuario);

    setFormulario({
      email: usuario.correo || usuario.email || "",
      password: "",
    });

    setErrores({});
    setMostrarRegistro(false);
  };

  // ==========================================================
  // VALIDAR LOGIN
  // ==========================================================

  const validarLogin = () => {
    const nuevosErrores = {};

    // ========================================================
    // EMAIL
    // ========================================================

    if (!formulario.email.trim()) {
      nuevosErrores.email =
        "El correo electrÃ³nico es obligatorio.";
    } else if (
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
        formulario.email
      )
    ) {
      nuevosErrores.email =
        "Ingresa un correo electrÃ³nico vÃ¡lido.";
    }

    // ========================================================
    // PASSWORD
    // ========================================================

    if (!formulario.password) {
      nuevosErrores.password =
        "La contraseÃ±a es obligatoria.";
    } else if (formulario.password.length < 9) {
      nuevosErrores.password =
        "La contraseÃ±a debe tener mÃ­nimo 9 caracteres.";
    }

    setErrores(nuevosErrores);

    return Object.keys(nuevosErrores).length === 0;
  };

  // ==========================================================
  // INICIAR SESIÃ“N
  // ==========================================================

  const manejarSubmit = async (e) => {
    e.preventDefault();

    // ========================================================
    // VALIDAR FORMULARIO
    // ========================================================

    if (!validarLogin()) {
      return;
    }

    setCargando(true);
    setErrores({});

    try {
      // ======================================================
      // LOGIN CONTRA EL BACKEND
      // ======================================================

      const respuesta = await fetch(
        ""http://127.0.0.1:8000/auth/login"",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            email: formulario.email.trim().toLowerCase(),
            password: formulario.password,
          }),
        }
      );

      const datos = await respuesta.json();

      console.log(
        "Respuesta del servidor:",
        datos
      );

      // ======================================================
      // LOGIN INCORRECTO
      // ======================================================

      if (!respuesta.ok || !datos.success) {
        setErrores({
          email:
            datos.message ||
            "El correo o la contraseÃ±a son incorrectos.",
        });

        return;
      }

      // ======================================================
      // VERIFICAR TOKEN
      // ======================================================

      if (!datos.token) {
        setErrores({
          email:
            "El servidor no devolviÃ³ un token de autenticaciÃ³n.",
        });

        return;
      }

      // ======================================================
      // GUARDAR JWT
      // ======================================================

      const usuario = datos.usuario || {
        email: formulario.email.trim().toLowerCase(),
      };

      iniciarSesion(usuario, datos.token);


      // ======================================================
      // MOSTRAR INFORMACIÃ“N EN CONSOLA
      // ======================================================

      console.log(
        "Inicio de sesiÃ³n correcto:",
        usuario
      );

      console.log(
        "Rol del usuario:",
        usuario.rol_id
      );

      // ======================================================
      // ALERTA DE INICIO DE SESIÃ“N CORRECTO
      // ======================================================

      setMostrarAlerta(true);

      // ======================================================
      // REDIRECCIÃ“N SEGÃšN EL ROL
      //
      // 1 = Administrador
      // 2 = Cliente
      // ======================================================

      setTimeout(() => {
  const rol = Number(usuario.rol_id);

  if (rol === 1) {
    console.log("Administrador autenticado correctamente.");
    window.location.href = "/admin";

  } else if (rol === 2) {
    console.log("Cliente autenticado correctamente.");
    window.location.href = "/cliente";

  } else if (rol === 3) {
    console.log("Empleado autenticado correctamente.");
    window.location.href = "/empleado";

  } else {
    console.log("Rol no reconocido.");
    window.location.href = "/";
  }
}, 1800);

  } catch (error) {
    console.error(
      "Error al iniciar sesiÃ³n:",
      error
    );

    setErrores({
      email:
        "No se pudo conectar con el servidor. Verifica que el backend estÃ© ejecutÃ¡ndose.",
    });
  } finally {
    setCargando(false);
  }
};

// ==========================================================
// MOSTRAR RECUPERAR CONTRASEÃ‘A
// ==========================================================

if (mostrarRecuperar) {
  return (
    <RecuperarContrasena
      onBack={cerrarRecuperar}
    />
  );
}

// ==========================================================
// RENDER LOGIN
// ==========================================================

return (
  <>
    <main
      className="
          min-h-screen
          bg-[#EFE8DF]
          text-[#52070A]
          transition-colors
          duration-500
          dark:bg-[#160B0C]
          dark:text-[#F8F3EA]
        "
    >
      {/* ====================================================
            HERO LOGIN
        ==================================================== */}

      <section
        className="
            relative
            flex
            min-h-screen
            items-center
            justify-center
            overflow-hidden
            px-6
            py-16
          "
      >

        {/* ==================================================
              DECORACIONES
          ================================================== */}

        <div
          className="
              absolute
              -right-40
              -top-40
              h-96
              w-96
              rounded-full
              border
              border-[#D4AF37]/20
            "
        />

        <div
          className="
              absolute
              -bottom-40
              -left-40
              h-96
              w-96
              rounded-full
              border
              border-[#7F0303]/10
              dark:border-[#D4AF37]/10
            "
        />

        <div
          className="
              absolute
              left-1/2
              top-1/2
              h-[500px]
              w-[500px]
              -translate-x-1/2
              -translate-y-1/2
              rounded-full
              bg-[#D4AF37]/5
              blur-3xl
