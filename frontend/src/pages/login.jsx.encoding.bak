                      mb-2
                      block
                      text-sm
                      font-semibold
                      text-[#3D1717]
                      dark:text-[#F8F3EA]/90
                    "
                >
                  Correo electrÃ³nico
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  value={formulario.email}
                  onChange={manejarCambio}
                  placeholder="ejemplo@email.com"
                  required
                  className={`
                      w-full
                      rounded-2xl
                      border
                      ${errores.email
                      ? "border-[#7F0303]"
                      : "border-[#D8BA98]"
                    }
                      bg-[#F8F3EA]
                      px-5
                      py-3.5
                      text-[#3D1717]
                      outline-none
                      transition-all
                      duration-300
                      placeholder:text-[#927E70]
                      focus:border-[#D4AF37]
                      focus:ring-2
                      focus:ring-[#D4AF37]/20
                      dark:border-[#D4AF37]/25
                      dark:bg-[#160B0C]
                      dark:text-[#F8F3EA]
                      dark:placeholder:text-[#C8B9B5]/50
                      dark:focus:border-[#D4AF37]
                    `}
                />

                {errores.email && (
                  <p
                    className="
                        mt-2
                        text-xs
                        font-medium
                        text-[#7F0303]
                        dark:text-[#F0CC55]
                      "
                  >
                    {errores.email}
                  </p>
                )}

              </div>

              {/* CONTRASEÃ‘A */}

              <div>

                <div
                  className="
                      mb-2
                      flex
                      items-center
                      justify-between
                    "
                >

                  <label
                    htmlFor="password"
                    className="
                        text-sm
                        font-semibold
                        text-[#3D1717]
                        dark:text-[#F8F3EA]/90
                      "
                  >
                    ContraseÃ±a
                  </label>

                  <button
                    type="button"
                    onClick={abrirRecuperar}
                    className="
                        text-xs
                        font-semibold
                        text-[#7F0303]
                        transition-colors
                        hover:text-[#D4AF37]
                        dark:text-[#D4AF37]
                        dark:hover:text-[#F0CC55]
                      "
                  >
                    Â¿La olvidaste?
                  </button>

                </div>

                {/* INPUT PASSWORD */}

                <div className="relative">

                  <input
                    id="password"
                    name="password"
                    type={
                      mostrarPassword
                        ? "text"
                        : "password"
                    }
                    value={formulario.password}
                    onChange={manejarCambio}
                    placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
                    required
                    className={`
                        w-full
                        rounded-2xl
                        border
                        ${errores.password
                        ? "border-[#7F0303]"
                        : "border-[#D8BA98]"
                      }
                        bg-[#F8F3EA]
                        px-5
                        py-3.5
                        pr-14
                        text-[#3D1717]
                        outline-none
                        transition-all
                        duration-300
                        placeholder:text-[#927E70]/60
                        focus:border-[#D4AF37]
                        focus:ring-2
                        focus:ring-[#D4AF37]/20
                        dark:border-[#D4AF37]/25
                        dark:bg-[#160B0C]
                        dark:text-[#F8F3EA]
                        dark:placeholder:text-[#C8B9B5]/50
                        dark:focus:border-[#D4AF37]
                      `}
                  />

                  {/* MOSTRAR PASSWORD */}

                  <button
                    type="button"
                    onClick={() =>
                      setMostrarPassword(
                        !mostrarPassword
                      )
                    }
                    aria-label={
                      mostrarPassword
                        ? "Ocultar contraseÃ±a"
                        : "Mostrar contraseÃ±a"
                    }
                    className="
                        absolute
                        right-4
                        top-1/2
                        -translate-y-1/2
                        text-lg
                        text-[#7F0303]
                        transition-colors
                        duration-300
                        hover:text-[#D4AF37]
                        dark:text-[#D4AF37]
                        dark:hover:text-[#F0CC55]
                      "
                  >
                    {mostrarPassword ? "â—‰" : "â—‹"}
                  </button>

                </div>

                {errores.password && (
