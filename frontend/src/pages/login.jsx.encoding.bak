                  "
              >
                â€” MUGI
              </p>

            </div>

          </div>

          {/* ==================================================
                PANEL DERECHO
            ================================================== */}

          <div
            className="
                p-8
                md:p-12
                lg:p-14
              "
          >

            {/* LOGO MOBILE */}

            <div
              className="
                  mb-8
